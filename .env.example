# ============================================================
# AURA PLUS ERP - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# Supabase (get from: supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (server-side only — NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=https://erp.auraplustechnologies.com

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
# 1. Create a new project at supabase.com
# 2. Go to SQL Editor and run supabase-schema.sql
# 3. Go to Storage and create these buckets:
#    - company-assets (public)
#    - project-files (private)
#    - ticket-files (private)
#    - avatars (public)
# 4. Copy your Project URL and anon key from Settings → API
# 5. Create your first user:
#    Go to Authentication → Users → Invite user
#    Then run this SQL to give them super_admin role:
#
#    INSERT INTO users (id, email, full_name, role)
#    VALUES ('[auth-user-id]', 'you@email.com', 'Your Name', 'super_admin');
#
# 6. Deploy to Vercel:
#    vercel env add NEXT_PUBLIC_SUPABASE_URL
#    vercel env add NEXT_PUBLIC_SUPABASE_ANON_KEY
#    vercel --prod
# ============================================================
